"""Color identifiers used by HubOS3 sensors and lights."""

from typing import Final, TypeAlias

Color: TypeAlias = int

BLACK: Final[Color] = 0
MAGENTA: Final[Color] = 1
PURPLE: Final[Color] = 2
BLUE: Final[Color] = 3
AZURE: Final[Color] = 4
TURQUOISE: Final[Color] = 5
GREEN: Final[Color] = 6
YELLOW: Final[Color] = 7
ORANGE: Final[Color] = 8
RED: Final[Color] = 9
WHITE: Final[Color] = 10
UNKNOWN: Final[Color] = -1